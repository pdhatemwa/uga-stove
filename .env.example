APP_ENV=development
APP_NAME=UGA Stove
APP_BASE_URL=http://localhost:8501
DOMAIN=stoves.example.org
API_BASE_URL=http://api:8000
DATABASE_URL=postgresql+psycopg://uga_stove:change-me@db:5432/uga_stove
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
MAX_EVIDENCE_BYTES=8388608
EVIDENCE_STORAGE=local
EVIDENCE_LOCAL_DIR=/app/storage/evidence
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-this-before-first-start
POSTGRES_DB=uga_stove
POSTGRES_USER=uga_stove
POSTGRES_PASSWORD=change-me
